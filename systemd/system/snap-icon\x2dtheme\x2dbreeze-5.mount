[Unit]
Description=Mount unit for icon-theme-breeze, revision 5
After=snapd.mounts-pre.target
Before=snapd.mounts.target

[Mount]
What=/var/lib/snapd/snaps/icon-theme-breeze_5.snap
Where=/snap/icon-theme-breeze/5
Type=squashfs
Options=nodev,ro,x-gdu.hide,x-gvfs-hide
LazyUnmount=yes

[Install]
WantedBy=snapd.mounts.target
WantedBy=multi-user.target
