[Unit]
Description=Mount unit for gtk-theme-breeze, revision 8
After=snapd.mounts-pre.target
Before=snapd.mounts.target

[Mount]
What=/var/lib/snapd/snaps/gtk-theme-breeze_8.snap
Where=/snap/gtk-theme-breeze/8
Type=squashfs
Options=nodev,ro,x-gdu.hide,x-gvfs-hide
LazyUnmount=yes

[Install]
WantedBy=snapd.mounts.target
WantedBy=multi-user.target
